# Discord
DISCORD_TOKEN=
DEV_DISCORD_TOKEN=
# BOT_ENV=dev  # dev-режим: бот берёт DEV_DISCORD_TOKEN вместо DISCORD_TOKEN

# ВК-репост (issue #32): юзер-токен АДМИНА группы (групповой не умеет wall.post/фото/видео),
# scope wall,photos,video,docs,offline — например через vkhost.github.io;
# VK_GROUP_ID — строго положительное число.
# VK_USER_TOKEN даёт доступ и к ЛИЧНОЙ стене владельца — хранить только в .env,
# никогда в репо/чатах.
# Не заданы → фича выключена.
VK_USER_TOKEN=
VK_GROUP_ID=

# Вебхук уведомлений о падении systemd-сервиса (notify_failure.py на VDS)
FAILURE_WEBHOOK_URL=

# Ключи LLM-вендоров: имена соответствуют vendors[].env в data/ai_settings.yaml
GEMINI=
GROQ=
OR=
GHM=
DS=

# Веб-поиск ИИ: свой SearXNG-инстанс (опционально — без него используется ddgs).
# В settings.yml инстанса должно быть search.formats: [html, json]
# SEARXNG_URL=http://127.0.0.1:8888

# RCON Minecraft-сервера — legacy: сервер закрыт, /rcon и !пинг его не используют.
# Оставлено на случай, если сервер когда-нибудь откроют снова.
# RCON_HOST=
# RCON_PORT=25575
# RCON_PASSWORD=
